# Copy to .env and adjust. Never commit real credentials.

# demo: canned extractions for the 12 sample messages, no external call.
# live: one OpenAI Responses API call per analysed message (requires key and model).
AI_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Fixed date used to evaluate offer and quote validity.
DEMO_SCENARIO_DATE=2026-11-05

# Host port for the web app (bound to 127.0.0.1 only).
APP_PORT=8081